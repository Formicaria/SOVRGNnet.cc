# SOVRGNnet environment.
#
# For a real install you don't need this file — run ./install.sh and it writes
# a .env with generated secrets for you. This is the reference for developers
# and for anyone configuring by hand.

# Database (self-hosted Postgres; matches the docker-compose service)
DATABASE_URL=postgresql://sovrgn:CHANGE_ME@localhost:5432/sovrgnnet
DB_PASSWORD=CHANGE_ME

# Session/JWT secret — generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME

# Required to create the FIRST account, which becomes the administrator.
# Generate with: openssl rand -hex 32
#
# An instance with no accounts and no token set refuses to create one, and
# that is deliberate: a server is normally reachable before its owner has
# signed up, so whoever finds the address first would otherwise take it.
# Stops being needed once that first account exists.
SOVRGN_SETUP_TOKEN=CHANGE_ME

# App
VITE_APP_TITLE=SOVRGNnet
DOMAIN=sovrgnnet.cc
NODE_ENV=development
PORT=3000

# Matrix (Conduit)
MATRIX_HOMESERVER_URL=http://localhost:8008
# Baked into every Matrix user and room ID the moment it's created. Changing
# this after first launch orphans all existing chat history.
MATRIX_SERVER_NAME=sovrgnnet.cc
# Shared secret gating account creation on the homeserver, so it isn't an open
# signup target. The app registers users with it; nobody else has it.
MATRIX_REGISTRATION_TOKEN=CHANGE_ME
# Join the wider Matrix network. Off by default — your instance is yours.
MATRIX_ALLOW_FEDERATION=false

# IPFS (Kubo)
IPFS_API_URL=http://localhost:5001

# How people reach the instance: local | quick | tunnel | proxy
# Set by ./install.sh; read by ./sovrgnnet to pick the right compose profile.
SOVRGNNET_ACCESS_MODE=local
# Only for SOVRGNNET_ACCESS_MODE=tunnel (Cloudflare Zero Trust tunnel token)
CLOUDFLARE_TUNNEL_TOKEN=

# --- sovrgnnet.cc single sign-on (optional) ---
# Off unless you opt in. A server with this unset accepts only local accounts
# and is fully functional — it simply has nothing to do with central identity.
INSTANCE_ALLOW_SSO=false
# Where to fetch signing keys from. Only change this if you run your own
# identity provider.
IDENTITY_ISSUER=https://sovrgnnet.cc

# Web3 (optional — wallet login, post-v1)
VITE_WALLET_CONNECT_PROJECT_ID=

# Appservice ingest (ADR 0009). Both from `openssl rand -hex 32`; the same
# values go into dendrite/appservice.yaml. Unset = API-authored messaging.
MATRIX_APPSERVICE_AS_TOKEN=
MATRIX_APPSERVICE_HS_TOKEN=
