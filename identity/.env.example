# SOVRGNnet identity provider.
#
# This service issues the tokens every server verifies. Treat its secrets
# accordingly: the signing key is the one thing here that, if leaked, lets
# somebody impersonate any account on any server on the network.

# Its own database — separate from any SOVRGNnet server's.
DATABASE_URL=postgresql://identity:CHANGE_ME@localhost:5432/sovrgnnet_identity

# Ed25519 private key in PKCS#8 PEM. Generate one with:  pnpm keygen
# Newlines may be written as \n on a single line.
IDENTITY_SIGNING_KEY=

# Retired keys still published in JWKS during a rotation, comma-separated.
# Leave empty except while rotating — see identity/README.md.
IDENTITY_PREVIOUS_KEYS=

# The public address of this service. Goes into verification and reset links,
# and must match the issuer servers expect.
IDENTITY_PUBLIC_URL=https://sovrgnnet.cc

PORT=4000
NODE_ENV=development

# --- sign-in providers ---
# People sign in with these rather than a password here. Both an id and a
# secret are needed before a provider is offered; half-configured is ignored.
# See docs/adr/0004-identity-broker.md.
#
# Redirect URI to register with each provider:
#   https://id.sovrgnnet.cc/auth/<provider>/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# GitHub needs the user:email scope, or there's no verified address and
# therefore no safe account linking.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email delivery.
#   none     run without email at all — a supported choice, see below
#   console  print to stdout (development default)
#
# With MAIL_TRANSPORT=none, two things are permanently true:
#   · no address is verified, so servers never auto-link a sovrgnnet.cc
#     identity to an existing local account (auto-linking on an unverified
#     address is an account takeover)
#   · recovery codes are the ONLY way back into an account — no reset link,
#     no administrator who can help
#
# Production with this unset refuses to send rather than silently dropping
# verification and reset messages.
MAIL_TRANSPORT=none
