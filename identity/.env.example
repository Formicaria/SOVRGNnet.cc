# SOVRGNnet identity provider.
#
# This service issues the tokens every server verifies. Treat its secrets
# accordingly: the signing key is the one thing here that, if leaked, lets
# somebody impersonate any account on any server on the network.

# Its own database — separate from any SOVRGNnet server's.
DATABASE_URL=postgresql://identity:CHANGE_ME@localhost:5432/sovrgnnet_identity

# Ed25519 private key in PKCS#8 PEM. Generate one with:  pnpm keygen
# Newlines may be written as \n on a single line.
IDENTITY_SIGNING_KEY=

# Retired keys still published in JWKS during a rotation, comma-separated.
# Leave empty except while rotating — see identity/README.md.
IDENTITY_PREVIOUS_KEYS=

# The public address of this service. Goes into verification and reset links,
# and must match the issuer servers expect.
IDENTITY_PUBLIC_URL=https://sovrgnnet.cc

PORT=4000
NODE_ENV=development

# Email delivery. Verification gates safe account linking and password reset
# depends on it entirely, so production without a real transport will refuse
# to send rather than silently drop messages.
#   console  print to stdout (development default)
MAIL_TRANSPORT=console
