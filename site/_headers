/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Cache-Control: public, max-age=0, must-revalidate

# Cache lifetime here is bounded by one rule: can this URL's contents change?
#
# style.css and the two marks keep the same path across every deploy, so a long
# TTL pins visitors to whichever version they happened to fetch first. That is
# not a slightly stale page, it is new markup styled by an old stylesheet —
# which renders worse than no stylesheet at all. This cost a redesign once.
# Ten minutes, then revalidate; the files are small and Cloudflare answers most
# revalidations with a 304.
/assets/*
  Cache-Control: public, max-age=600, must-revalidate

# Fonts are the exception, because their filenames are content-stable: family,
# weight and subset are all in the name, so different bytes mean a different
# URL and a stale copy is impossible.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Matrix federation and client delegation. Third-party Matrix clients and other
# homeservers read these to find the real homeserver behind sovrgnnet.cc.
/.well-known/matrix/*
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
