# Database Configuration
DB_ROOT_PASSWORD=your_secure_root_password_here
DB_PASSWORD=your_secure_db_password_here

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# Required to create the first account, which becomes the administrator.
# Generate with: openssl rand -hex 32
# Without it the instance refuses to create that account — otherwise whoever
# reaches a freshly deployed server first can claim it.
SOVRGN_SETUP_TOKEN=your_setup_token_here



# App Configuration
VITE_APP_TITLE=SOVRGNnet
VITE_APP_LOGO=https://your-domain.com/logo.png
VITE_ANALYTICS_ENDPOINT=https://analytics.your-domain.com
VITE_ANALYTICS_WEBSITE_ID=your_analytics_id

# Matrix Configuration
MATRIX_HOMESERVER_URL=http://matrix:8008
MATRIX_SERVER_NAME=matrix.your-domain.com

# IPFS Configuration
IPFS_API_URL=http://ipfs:5001

# Web3 Configuration
REACT_APP_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id

# Node Environment
NODE_ENV=production

# Optional: Nginx/SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
DOMAIN=your-domain.com

# Cloudflare Tunnel (Zero Trust dashboard -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# Appservice ingest (ADR 0009) — lets clients author events over their own
# Matrix sessions while the instance's database stays an accurate index.
# Generate each with: openssl rand -hex 32. The same values go into the
# registration file (dendrite/appservice.yaml.template) wired into Dendrite.
# Leave both unset to keep API-authored messaging exactly as before.
MATRIX_APPSERVICE_AS_TOKEN=
MATRIX_APPSERVICE_HS_TOKEN=
