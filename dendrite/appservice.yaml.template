# SOVRGNnet appservice registration — ADR 0009.
#
# This file tells the homeserver to push every event to the instance, which is
# how the database stays an accurate index once clients author events over
# their own Matrix sessions (and, under stage 4, author events nobody but the
# members can read).
#
# Rendered by whatever installs the instance — install.sh, the desktop
# supervisor, the e2e harnesses — never by hand (ADR 0015). The two tokens are
# independent secrets generated by the installer; the same values reach the
# instance as MATRIX_APPSERVICE_AS_TOKEN and MATRIX_APPSERVICE_HS_TOKEN.
# dendrite.yaml.template lists the rendered file under `app_service_api`, so
# there is nothing to wire: the instance's `eventIngest` capability is true
# from the first start.

id: sovrgnnet
# Where the homeserver pushes transactions: `http://app:3000` under compose,
# the app's loopback port on a desktop host. Filled by the renderer, because
# the desktop's port is chosen at each start.
url: "{{APP_URL}}"

# Instance → homeserver. Unused today; reserved for appservice-authenticated
# calls later.
as_token: "{{AS_TOKEN}}"

# Homeserver → instance. Checked on every transaction push; a wrong token is
# a 403 and a log line.
hs_token: "{{HS_TOKEN}}"

# A dedicated service identity. It observes; it never posts.
sender_localpart: sovrgnnet_service

# The instance is not a rate-limited guest of its own homeserver.
rate_limited: false

# This appservice exists to receive events, not to own user ids, aliases, or
# rooms — hence exclusive: false everywhere. It claims no name; it only asks to
# be told about things.
#
# The user regex is what drives delivery. A homeserver pushes a room's events to
# an appservice when that appservice's sender is a member, or when a user
# matching one of its namespaces is. The service user is invited to nothing, so
# the namespace is doing all of the work.
#
# It was "@sovrgn_.*" while every account's localpart was `sovrgn_<id>`. Once
# localparts became usernames (task #31) that pattern stopped matching anyone,
# and the effect would have been silent: rooms still work, messages still send,
# and the database simply stops being told about any of it — an index that
# quietly drifts from the homeserver it is supposed to mirror.
#
# ".*" matches every local user, which is the honest expression of what an
# ingest appservice wants. exclusive: false is load-bearing: exclusive: true on
# this pattern would hand the appservice ownership of the entire user namespace
# and stop the homeserver letting anyone else register at all.
namespaces:
  users:
    - exclusive: false
      regex: ".*"
  aliases: []
  rooms: []
