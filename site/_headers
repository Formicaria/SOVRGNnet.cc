/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=604800

# Font files are content-stable: the filename carries the family, weight and
# subset, so a change means a new name rather than new bytes at the same one.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Matrix federation and client delegation. Third-party Matrix clients and other
# homeservers read these to find the real homeserver behind sovrgnnet.cc.
/.well-known/matrix/*
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
