# Rust build output — hundreds of megabytes, regenerated by every build.
src-tauri/target/

# Vite output for the desktop frontend.
dist/

# Generated by `tauri build`, not authored.
src-tauri/gen/

node_modules/

# NOT ignored, deliberately:
#   src-tauri/icons/    generated once by `tauri icon`, but the build reads
#                       them and CI has no source image — they must be
#                       committed or every release build fails
#   src-tauri/icon.png  the source the icons were generated from
#   Cargo.lock          pinned dependencies; a binary crate wants this
