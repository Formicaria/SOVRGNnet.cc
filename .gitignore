# Dependencies
**/node_modules
.pnpm-store/

# Build outputs
dist/
build/
*.dist

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
# install.sh / restore.sh keep timestamped copies of your old settings
.env.backup.*
.env.before-restore.*

# Backups contain secrets and user data — never commit them
backups/

# The generated homeserver config and its signing key.
#
# dendrite.yaml carries the registration shared secret: whatever holds it can
# create an account on the homeserver. matrix_key.pem *is* the instance's
# identity on the Matrix network — publishing it lets anyone impersonate the
# server to everyone it has ever federated with, and the damage isn't undone by
# rotating it.
#
# Only the template is tracked; install.sh and scripts/e2e.sh generate the rest.
dendrite/dendrite.yaml
dendrite/matrix_key.pem

# Real certificates and private keys for the proxy deployment.
ssl/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock
*.bak

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/
dendrite/matrix_key.pem
dendrite/dendrite.yaml
dendrite/appservice-e2e.yaml
# Rendered by scripts/e2e-federation.sh — configs, signing keys, appservice
# registrations, and throwaway TLS pairs for the two-instance harness.
dendrite/fed-*/
# Host-server components assembled by scripts/host-bundle.sh — binaries,
# never committed. The README stays so the directory exists for dev builds.
desktop/src-tauri/host/*
!desktop/src-tauri/host/README
