# SOVRGNnet environment — copy to .env and fill in. Never commit .env.

# Database (self-hosted Postgres; matches docker-compose service)
DATABASE_URL=postgresql://sovrgn:CHANGE_ME@localhost:5432/sovrgnnet
DB_PASSWORD=CHANGE_ME

# Session/JWT secret — generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME

# App
VITE_APP_TITLE=SOVRGNnet
DOMAIN=sovrgnnet.cc
NODE_ENV=development
PORT=3000

# Matrix (Conduit)
MATRIX_HOMESERVER_URL=http://localhost:8008
MATRIX_SERVER_NAME=sovrgnnet.cc

# IPFS (Kubo)
IPFS_API_URL=http://localhost:5001
VITE_IPFS_GATEWAY=https://sovrgnnet.cc/ipfs/

# Web3 (optional — wallet login, post-v1)
VITE_WALLET_CONNECT_PROJECT_ID=
