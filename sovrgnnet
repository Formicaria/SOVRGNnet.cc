#!/usr/bin/env bash
#
# SOVRGNnet control script — the handful of things you'll actually do.
#
#   sovrgnnet start | stop | restart | status | logs | url | backup | update
#
# Works with either install:
#   Docker (./install.sh)          -> wraps docker compose
#   Native/LXC (install-lxc.sh)    -> wraps systemctl
#
# It figures out which one you have by looking for /etc/sovrgnnet/sovrgnnet.env.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$REPO_DIR"

if [ -t 1 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  RED=$(tput setaf 1); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; RED=""; GREEN=""; YELLOW=""
fi

ok()   { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$*"; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$RESET" "$*"; }
fail() { printf '%serror:%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }
hint() { printf '  %s%s%s\n' "$DIM" "$*" "$RESET"; }

# ------------------------------------------------------------ which install?

# Overridable so the script can be exercised without a real system install.
NATIVE_ENV="${SOVRGNNET_NATIVE_ENV:-/etc/sovrgnnet/sovrgnnet.env}"

if [ -f "$NATIVE_ENV" ]; then
  RUNTIME="native"
  ENV_FILE="$NATIVE_ENV"
elif [ -f "$REPO_DIR/.env" ]; then
  RUNTIME="docker"
  ENV_FILE="$REPO_DIR/.env"
else
  fail "No settings found. Run ./install.sh (Docker) or scripts/install-lxc.sh (native)."
fi

read_env() { sed -n "s/^${1}=//p" "$ENV_FILE" 2>/dev/null | tail -1; }

ACCESS_MODE="$(read_env SOVRGNNET_ACCESS_MODE)"
DOMAIN="$(read_env DOMAIN)"

# Native services, in dependency order.
#
# `dendrite`, not `conduit`. ADR 0006 replaced the homeserver and
# install-lxc.sh has written a dendrite.service ever since; this list did not
# follow. The consequence was not a cosmetic wrong label in `status` — because
# this script runs under `set -e`, `systemctl start postgresql conduit ...`
# aborted on the missing unit, so `sovrgnnet start` never reached ipfs or the
# app itself. A native install could only be started by hand.
NATIVE_UNITS="postgresql dendrite ipfs sovrgnnet"
[ -f /etc/systemd/system/sovrgnnet-tunnel.service ] && \
  NATIVE_UNITS="$NATIVE_UNITS sovrgnnet-tunnel"

if [ "$RUNTIME" = "docker" ]; then
  if docker compose version >/dev/null 2>&1; then
    DC="docker compose"
  elif command -v docker-compose >/dev/null 2>&1; then
    DC="docker-compose"
  else
    fail "Docker Compose isn't installed."
  fi
  case "$ACCESS_MODE" in
    quick)  PROFILES="--profile quick" ;;
    tunnel) PROFILES="--profile tunnel" ;;
    proxy)  PROFILES="--profile proxy" ;;
    *)      PROFILES="" ;;
  esac
fi

# Anything touching systemd needs root; re-exec rather than failing obscurely.
need_root() {
  [ "$RUNTIME" = "native" ] || return 0
  [ "$(id -u)" -eq 0 ] && return 0
  command -v sudo >/dev/null 2>&1 || fail "Run this as root."
  exec sudo -- "$0" "$@"
}

lan_ip() {
  local ip=""
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1); exit}')
  [ -z "$ip" ] && ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  printf '%s' "${ip:-localhost}"
}

quick_url() {
  if [ "$RUNTIME" = "native" ]; then
    journalctl -u sovrgnnet-tunnel --no-pager 2>/dev/null \
      | grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' | tail -1 || true
  else
    $DC logs cloudflared-quick 2>/dev/null \
      | grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' | tail -1 || true
  fi
}

show_url() {
  case "$ACCESS_MODE" in
    quick)
      local url; url="$(quick_url)"
      if [ -n "$url" ]; then
        printf '  %s%s%s\n' "$BOLD" "$url" "$RESET"
        hint "Random address — it changes every time you restart."
      else
        warn "No public link yet. Is it running? Try: sovrgnnet status"
      fi
      ;;
    tunnel|proxy)
      printf '  %shttps://%s%s\n' "$BOLD" "$DOMAIN" "$RESET"
      ;;
    *)
      printf '  %shttp://%s:3000%s\n' "$BOLD" "$(lan_ip)" "$RESET"
      hint "Reachable by anyone on your network."
      ;;
  esac
}

app_answering() {
  curl -fsS -o /dev/null http://127.0.0.1:3000 2>/dev/null
}

# How long since the last backup, and did it leave the machine?
#
# In `status` because that is where someone looks when they are worried, and
# because a backup that stopped running produces no error anywhere — the timer
# is fine, the disk is fine, and the last archive just keeps getting older. The
# only way to notice is to be told the age.
backup_line() {
  local newest age days dest
  newest="$(ls -1t "$REPO_DIR"/backups/sovrgnnet_backup_*.tar.gz* 2>/dev/null | head -1 || true)"

  if [ -z "$newest" ]; then
    printf '  %s✗%s %-18s %s\n' "$RED" "$RESET" "backup" "never taken"
    hint "sovrgnnet backup"
    return
  fi

  age=$(( $(date +%s) - $(stat -c %Y "$newest" 2>/dev/null || echo 0) ))
  days=$(( age / 86400 ))

  if [ "$days" -le 1 ]; then
    printf '  %s✓%s %-18s %s\n' "$GREEN" "$RESET" "backup" "$(basename "$newest")"
  else
    printf '  %s✗%s %-18s %s\n' "$RED" "$RESET" "backup" "${days} days old"
    hint "Is sovrgnnet-backup.timer running? systemctl list-timers sovrgnnet-backup"
  fi

  dest="$(read_env SOVRGN_BACKUP_DEST)"
  if [ -z "$dest" ]; then
    # Not an error, and not a pass either. A copy on the disk it protects
    # survives a mistake and nothing else.
    printf '  %s!%s %-18s %s\n' "$YELLOW" "$RESET" "" "local only — set SOVRGN_BACKUP_DEST"
  fi
}

# shellcheck disable=SC2086
case "${1:-help}" in
  start)
    need_root "$@"
    if [ "$RUNTIME" = "native" ]; then
      systemctl start $NATIVE_UNITS
    else
      $DC $PROFILES up -d
    fi
    ok "Started."
    show_url
    ;;

  stop)
    need_root "$@"
    if [ "$RUNTIME" = "native" ]; then
      # Reverse order: the app first, its dependencies after.
      systemctl stop sovrgnnet-tunnel 2>/dev/null || true
      systemctl stop sovrgnnet ipfs conduit
    else
      $DC $PROFILES down
    fi
    ok "Stopped. Your data is safe — sovrgnnet start brings it back."
    ;;

  restart)
    need_root "$@"
    if [ "$RUNTIME" = "native" ]; then
      systemctl restart $NATIVE_UNITS
    else
      $DC $PROFILES restart
    fi
    ok "Restarted."
    [ "$ACCESS_MODE" = "quick" ] && hint "Your public link changed: sovrgnnet url"
    ;;

  status)
    if [ "$RUNTIME" = "native" ]; then
      for unit in $NATIVE_UNITS; do
        state="$(systemctl is-active "$unit" 2>/dev/null || echo unknown)"
        if [ "$state" = "active" ]; then
          printf '  %s✓%s %-18s %s\n' "$GREEN" "$RESET" "$unit" "$state"
        else
          printf '  %s✗%s %-18s %s\n' "$RED" "$RESET" "$unit" "$state"
        fi
      done
    else
      $DC $PROFILES ps
    fi
    printf '\n'
    backup_line
    printf '\n'
    if app_answering; then
      ok "The app is answering."
      show_url
    else
      warn "The app isn't answering yet."
      hint "Just started? Give it a minute. Otherwise: sovrgnnet logs"
    fi
    ;;

  logs)
    shift || true
    if [ "$RUNTIME" = "native" ]; then
      journalctl -f -n 100 -u "${1:-sovrgnnet}"
    else
      $DC $PROFILES logs -f --tail 100 "$@"
    fi
    ;;

  url)
    show_url
    ;;

  backup)
    need_root "$@"
    "$REPO_DIR/scripts/backup.sh"
    ;;

  verify)
    # No root needed — this only reads.
    "$REPO_DIR/scripts/verify-backup.sh" "${2:-}"
    ;;

  restore)
    need_root "$@"
    "$REPO_DIR/scripts/restore.sh" "${2:-}"
    ;;

  update)
    need_root "$@"

    FORCE=0; ASSUME_YES=0
    for arg in "${@:2}"; do
      case "$arg" in
        -f|--force) FORCE=1 ;;
        -y|--yes)   ASSUME_YES=1 ;;
        *) fail "Unknown option $arg. Usage: sovrgnnet update [--force] [--yes]" ;;
      esac
    done

    if [ "$FORCE" -eq 1 ]; then
      # An ordinary update refuses to touch a repository with local edits, and
      # that is the right default — silently discarding someone's change is
      # worse than stopping. --force is the escape hatch for the case where you
      # know the local state is disposable and you want the remote's version.
      #
      # It also re-pulls images. A plain `up -d --build` reuses whatever is
      # already in the local image cache, so a version tag that was rebuilt
      # upstream (an Alpine base-layer CVE fix, say) never arrives. That is
      # invisible: everything reports the same version and runs older bytes.
      BRANCH="$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD)"
      git -C "$REPO_DIR" fetch --quiet origin

      printf '\n  %sForce update%s — this discards local changes.\n\n' "$BOLD" "$RESET"
      printf '  Branch:  %s\n' "$BRANCH"
      printf '  Moving:  %s -> %s\n' \
        "$(git -C "$REPO_DIR" rev-parse --short HEAD)" \
        "$(git -C "$REPO_DIR" rev-parse --short "origin/$BRANCH")"

      DIRTY="$(git -C "$REPO_DIR" status --porcelain)"
      if [ -n "$DIRTY" ]; then
        printf '\n  %sThese tracked files will be reset:%s\n' "$YELLOW" "$RESET"
        printf '%s\n' "$DIRTY" | sed 's/^/    /'
      fi

      # Untracked files are left alone, on purpose. `git clean` is the reflex
      # here and it would delete .env — the database password, the JWT secret,
      # the Matrix shared secret. There is no version of "force update" that
      # should destroy the instance's identity, so the option isn't offered.
      hint ""
      hint "Untracked files (including .env) are left alone."

      if [ "$ASSUME_YES" -ne 1 ]; then
        printf '\n  Type %syes%s to continue: ' "$BOLD" "$RESET"
        read -r reply
        [ "$reply" = "yes" ] || fail "Stopped. Nothing changed."
      fi

      printf '\n  Backing up first...\n'
      # The way back. If this fails the force update does not happen — the
      # whole point of the confirmation above is that you can undo the result.
      "$REPO_DIR/scripts/backup.sh" >/dev/null \
        || fail "Backup failed, so the update stopped. Fix that first: sovrgnnet backup"
      ok "Backup taken"

      git -C "$REPO_DIR" reset --hard "origin/$BRANCH" --quiet
      ok "Reset to origin/$BRANCH"

      if [ "$RUNTIME" = "native" ]; then
        rm -rf "$REPO_DIR/node_modules" "$REPO_DIR/dist"
        ( cd "$REPO_DIR" && pnpm install --frozen-lockfile --silent && pnpm build >/dev/null )
        chown -R sovrgnnet:sovrgnnet "$REPO_DIR/dist"
        systemctl restart sovrgnnet

        # Refresh cloudflared too. install-lxc.sh fetches it only when the
        # binary is absent, so on a native install it is downloaded once, at
        # install time, and never again — no pin to bump, no package manager
        # to notice, nothing that reports it as stale. A box installed a year
        # ago is running a year-old build of the one process here with an
        # unsolicited path to the internet.
        if [ -x /usr/local/bin/cloudflared ]; then
          case "$(uname -m)" in
            x86_64)  CF_ARCH="amd64" ;;
            aarch64) CF_ARCH="arm64" ;;
            *)       CF_ARCH="" ;;
          esac
          if [ -n "$CF_ARCH" ] && curl -fsSL -o /tmp/cloudflared.new \
              "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${CF_ARCH}"; then
            # Replace only after the download succeeded, so a network failure
            # leaves a working tunnel rather than a truncated binary.
            chmod +x /tmp/cloudflared.new
            mv /tmp/cloudflared.new /usr/local/bin/cloudflared
            systemctl restart sovrgnnet-tunnel 2>/dev/null || true
            ok "cloudflared refreshed ($(/usr/local/bin/cloudflared --version 2>/dev/null | head -1))"
          else
            rm -f /tmp/cloudflared.new
            warn "Couldn't refresh cloudflared — left the working one in place."
          fi
        fi
      else
        $DC $PROFILES pull
        $DC $PROFILES build --pull --no-cache
        $DC $PROFILES up -d --force-recreate
      fi
      ok "Force updated and restarted. (Database changes applied automatically.)"
      hint "If this went badly: sovrgnnet restore"
    else
      printf '  Fetching the latest version...\n'
      git -C "$REPO_DIR" pull --ff-only \
        || fail "Couldn't update — the repository has local changes or has diverged.
  Look:  git -C $REPO_DIR status
  Or discard them and take the remote's version:  sovrgnnet update --force"
      if [ "$RUNTIME" = "native" ]; then
        ( cd "$REPO_DIR" && pnpm install --frozen-lockfile --silent && pnpm build >/dev/null )
        chown -R sovrgnnet:sovrgnnet "$REPO_DIR/dist"
        systemctl restart sovrgnnet
      else
        $DC $PROFILES up -d --build
      fi
      ok "Updated and restarted. (Database changes applied automatically.)"
    fi
    ;;

  *)
    printf '\n  %sSOVRGNnet%s %s(%s install)%s\n\n' "$BOLD" "$RESET" "$DIM" "$RUNTIME" "$RESET"
    printf '    %ssovrgnnet start%s      turn it on\n' "$BOLD" "$RESET"
    printf '    %ssovrgnnet stop%s       turn it off\n' "$BOLD" "$RESET"
    printf '    %ssovrgnnet restart%s    turn it off and on again\n' "$BOLD" "$RESET"
    printf '    %ssovrgnnet status%s     is everything healthy?\n' "$BOLD" "$RESET"
    printf '    %ssovrgnnet url%s        what address do people use?\n' "$BOLD" "$RESET"
    printf '    %ssovrgnnet logs%s       watch what it is doing\n' "$BOLD" "$RESET"
    printf '    %ssovrgnnet backup%s     save a copy of everything\n' "$BOLD" "$RESET"
    printf '    %ssovrgnnet verify%s     check a backup without restoring it\n' "$BOLD" "$RESET"
    printf '    %ssovrgnnet restore%s    put a backup back\n' "$BOLD" "$RESET"
    printf '    %ssovrgnnet update%s     get the latest version\n' "$BOLD" "$RESET"
    printf '    %ssovrgnnet update --force%s\n' "$BOLD" "$RESET"
    printf '      %sdiscard local changes, re-pull images, rebuild from scratch%s\n' "$DIM" "$RESET"
    printf '\n'
    ;;
esac
