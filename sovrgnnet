#!/usr/bin/env bash
#
# SOVRGNnet control script — the handful of things you'll actually do.
#
#   ./sovrgnnet start | stop | restart | status | logs | url | backup | update
#
# Everything here is a thin wrapper over docker compose. If you'd rather use
# docker directly, nothing stops you.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_DIR"

if [ -t 1 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  RED=$(tput setaf 1); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; RED=""; GREEN=""; YELLOW=""
fi

ok()   { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$*"; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$RESET" "$*"; }
fail() { printf '%serror:%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }
hint() { printf '  %s%s%s\n' "$DIM" "$*" "$RESET"; }

[ -f .env ] || fail "No .env found. Run ./install.sh first."

if docker compose version >/dev/null 2>&1; then
  DC="docker compose"
elif command -v docker-compose >/dev/null 2>&1; then
  DC="docker-compose"
else
  fail "Docker Compose isn't installed. Run ./install.sh."
fi

ACCESS_MODE="$(sed -n 's/^SOVRGNNET_ACCESS_MODE=//p' .env | tail -1)"
DOMAIN="$(sed -n 's/^DOMAIN=//p' .env | tail -1)"

case "$ACCESS_MODE" in
  quick)  PROFILES="--profile quick" ;;
  tunnel) PROFILES="--profile tunnel" ;;
  proxy)  PROFILES="--profile proxy" ;;
  *)      PROFILES="" ;;
esac

lan_ip() {
  local ip=""
  if command -v ip >/dev/null 2>&1; then
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1); exit}')
  fi
  [ -z "$ip" ] && ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  printf '%s' "${ip:-localhost}"
}

show_url() {
  case "$ACCESS_MODE" in
    quick)
      local url
      url=$($DC logs cloudflared-quick 2>/dev/null \
            | grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' | tail -1 || true)
      if [ -n "$url" ]; then
        printf '  %s%s%s\n' "$BOLD" "$url" "$RESET"
        hint "Random address — it changes every time you restart."
      else
        warn "No public link yet. Is it running? Try: ./sovrgnnet status"
      fi
      ;;
    tunnel|proxy)
      printf '  %shttps://%s%s\n' "$BOLD" "$DOMAIN" "$RESET"
      ;;
    *)
      printf '  %shttp://%s:3000%s\n' "$BOLD" "$(lan_ip)" "$RESET"
      hint "Reachable by anyone on your network."
      ;;
  esac
}

# shellcheck disable=SC2086
case "${1:-help}" in
  start)
    $DC $PROFILES up -d
    ok "Started."
    show_url
    ;;

  stop)
    $DC $PROFILES down
    ok "Stopped. Your data is safe — ./sovrgnnet start brings it back."
    ;;

  restart)
    $DC $PROFILES restart
    ok "Restarted."
    [ "$ACCESS_MODE" = "quick" ] && hint "Your public link changed. See it with: ./sovrgnnet url"
    ;;

  status)
    $DC $PROFILES ps
    printf '\n'
    if curl -fsS -o /dev/null http://localhost:3000 2>/dev/null; then
      ok "The app is answering."
      show_url
    else
      warn "The app isn't answering yet."
      hint "Just started? Give it a minute. Otherwise: ./sovrgnnet logs"
    fi
    ;;

  logs)
    shift || true
    $DC $PROFILES logs -f --tail 100 "$@"
    ;;

  url)
    show_url
    ;;

  backup)
    ./scripts/backup.sh
    ;;

  update)
    printf '  Fetching the latest version...\n'
    git pull --ff-only || fail "Couldn't update. Do you have local changes? Try: git status"
    $DC $PROFILES up -d --build
    ok "Updated and restarted. (Database changes applied automatically.)"
    ;;

  *)
    printf '\n  %sSOVRGNnet%s\n\n' "$BOLD" "$RESET"
    printf '    %s./sovrgnnet start%s      turn it on\n' "$BOLD" "$RESET"
    printf '    %s./sovrgnnet stop%s       turn it off\n' "$BOLD" "$RESET"
    printf '    %s./sovrgnnet restart%s    turn it off and on again\n' "$BOLD" "$RESET"
    printf '    %s./sovrgnnet status%s     is everything healthy?\n' "$BOLD" "$RESET"
    printf '    %s./sovrgnnet url%s        what address do people use?\n' "$BOLD" "$RESET"
    printf '    %s./sovrgnnet logs%s       watch what it is doing\n' "$BOLD" "$RESET"
    printf '    %s./sovrgnnet backup%s     save a copy of everything\n' "$BOLD" "$RESET"
    printf '    %s./sovrgnnet update%s     get the latest version\n' "$BOLD" "$RESET"
    printf '\n'
    ;;
esac
