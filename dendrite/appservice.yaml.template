# SOVRGNnet appservice registration — ADR 0009.
#
# This file tells the homeserver to push every event to the instance, which is
# how the database stays an accurate index once clients author events over
# their own Matrix sessions (and, under stage 4, author events nobody but the
# members can read).
#
# Generate the two tokens with `openssl rand -hex 32` — they are independent
# secrets. The same values go into the instance environment as
# MATRIX_APPSERVICE_AS_TOKEN and MATRIX_APPSERVICE_HS_TOKEN.
#
# Wire it into Dendrite by listing this file under `app_service_api` in
# dendrite.yaml:
#
#   app_service_api:
#     config_files:
#       - /etc/dendrite/appservice.yaml
#
# and restart the homeserver. The instance's `eventIngest` capability flips to
# true on its own once both env tokens are present.

id: sovrgnnet
# Where the homeserver pushes transactions. In the stock compose deployment
# the app is reachable from Dendrite as `app`; adjust for other shapes.
url: "http://app:3000"

# Instance → homeserver. Unused today; reserved for appservice-authenticated
# calls later.
as_token: "{{AS_TOKEN}}"

# Homeserver → instance. Checked on every transaction push; a wrong token is
# a 403 and a log line.
hs_token: "{{HS_TOKEN}}"

# A dedicated service identity. It observes; it never posts.
sender_localpart: sovrgnnet_service

# The instance is not a rate-limited guest of its own homeserver.
rate_limited: false

# Empty claims: this appservice exists to receive events, not to own user ids,
# aliases, or rooms. The homeserver pushes events for rooms its sender or
# namespaced users are in — the service user is invited to nothing, so what
# actually drives delivery is the registration's presence plus Dendrite
# pushing all local events to interested appservices with empty namespaces
# marked exclusive=false.
namespaces:
  users:
    - exclusive: false
      regex: "@sovrgn_.*"
  aliases: []
  rooms: []
